{
  "installCommand": "npm install --no-audit --no-fund",
  "git": { "deploymentEnabled": true },
  "rewrites": [
    {
      "source": "/((?!robots\\.txt$|sitemap\\.xml$|manifest\\.webmanifest$|favicon\\.svg$|assets/|brand/|fonts/|images/|payments/|public-site/).*)",
      "destination": "/index.html"
    }
  ]
}
